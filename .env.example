# Telegram Bot Tokeningizni @BotFather orqali olib bu yerga yozing:
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Faqat o'zingiz foydalanishingiz uchun Telegram ID ngizni yozing (@userinfobot dan bilib oling).
# Bir nechta bo'lsa vergul bilan: 123456789,987654321. Bo'sh qolsa - bot hamma uchun ochiq!
ALLOWED_USER_IDS=

# Boshqa sozlamalar (ixtiyoriy)
DEFAULT_SYMBOL=XAUUSD
DEFAULT_TIMEFRAME=1h
MIN_CONFIDENCE_THRESHOLD=60
MIN_SIGNAL_MARGIN=20
DEFAULT_RISK_PERCENT=1.0
TIMEZONE=Asia/Tashkent
